{
  "name": "gasolineras",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "importar": "node --env-file-if-exists=.env.local scripts/importar.mts",
    "postinstall": "node -e \"require('fs').copyFileSync('node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs','public/maplibre-gl-worker.mjs')\"",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "importar-aparcamientos": "node --env-file-if-exists=.env.local scripts/importar-aparcamientos.mts",
    "importar-zonas": "node --env-file-if-exists=.env.local scripts/importar-zonas.mts"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@opennextjs/cloudflare": "^1.20.18",
    "@supabase/supabase-js": "^2.119.2",
    "maplibre-gl": "^6.19.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5",
    "wrangler": "^4.166.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261119.1": true
  }
}
