{
  // Configuración de Cloudflare Workers (desplegado con @opennextjs/cloudflare)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gasolineras",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // SUPABASE_URL y SUPABASE_PUBLISHABLE_KEY se configuran en el panel de Cloudflare
  // (Worker → Settings → Variables and Secrets). keep_vars evita que cada despliegue las borre.
  // ¡Nunca pongas aquí la Secret key (sb_secret_...)! La web no la necesita.
  "keep_vars": true,
  "observability": { "enabled": true }
}
